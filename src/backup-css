:root{
  --primary:#0F766E;
  --primary-dark:#0B5F58;
  --secondary:#14B8A6;
  --accent:#F59E0B;

  --bg:#F8FAFC;
  --card:#FFFFFF;

  --text:#0F172A;
  --muted:#64748B;

  --shadow:0 10px 30px rgba(15,23,42,0.08);
  --radius:22px;
}
*{
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body{
  font-family: Poppins, sans-serif;
  background: #F5F7F5;
}

.login-container{
  height: 100vh;

  display: flex;
  flex-direction: column;

  justify-content: center;
  align-items: center;

  gap: 20px;
}

.logo{
  font-size: 80px;
  margin-bottom: 20px;
}

h1{
  color: #0F766E;
  font-size: 65px;
  font-weight: 700;
}

h2{
  color: #374151;
  font-size: 35px;
  margin-top: -15px;
}

h3{
  color: #6B7280;
  margin-bottom: 25px;
  font-size: 18px;
}

input,
textarea,
select{
    width:100%;
    padding:16px;
    border:2px solid #E2E8F0;
    border-radius:16px;
    font-size:15px;
    background:white;
    transition:0.3s;
    outline:none;
}

input:focus,
textarea:focus,
select:focus{
    border-color:#14B8A6;
    box-shadow:0 0 0 4px rgba(20,184,166,0.15);
}

button{
    width:100%;
    padding:16px;
    border:none;
    border-radius:16px;

    background:linear-gradient(
        135deg,
        #14B8A6,
        #0F766E
    );

    color:white;
    font-size:16px;
    font-weight:600;

    cursor:pointer;

    transition:0.3s;
}

button:hover{
    transform:translateY(-3px);
}

.card{
    background:white;
    border-radius:24px;
    padding:30px;
    text-align:center;

    border:1px solid #E2E8F0;

    box-shadow:0 10px 30px rgba(15,23,42,0.08);

    transition:0.3s;
}

.card:hover{
    transform:translateY(-10px);

    box-shadow:0 20px 40px rgba(15,23,42,0.12);
}
.section-card{
    margin-top:20px;
    background:white;
    padding:25px;
    border-radius:24px;
    border:1px solid #E2E8F0;
    box-shadow:0 10px 30px rgba(15,23,42,0.08);
    transition:0.3s;
}

.section-card:hover{
    transform:translateY(-5px);
    box-shadow:0 20px 40px rgba(15,23,42,0.12);
}
